# Copy to .env and edit. Never commit .env.

# Required: the console password, stored as a scrypt hash. Make one with:
#   python -m hallway.passwd
# and paste the ADMIN_PASSWORD_HASH=... line it prints here.
ADMIN_PASSWORD_HASH=

# Optional: a token (16+ random characters) for scripts that call the API with a header.
# Leave empty if you do not need one. The server refuses to start with neither this nor the hash.
ADMIN_TOKEN=

# Required for the Raspberry Pi player: read-only token, must differ from ADMIN_TOKEN.
LOOP_TOKEN=

# Spend cap in USD (lifetime total) and per UTC day. Active from the first run.
# An empty, unreadable, zero, negative, NaN, infinite or absurd value falls back to
# the default. It never means "unlimited". Raising the cap requires editing this
# file and restarting.
SPEND_CAP_USD=5
SPEND_CAP_DAILY_USD=2

# Provider: "mock" makes fake clips for free (tests, first look); "gemini" is the real one.
# The mock costs nothing and does not use up the spend cap.
PROVIDER=mock

# Set to 1 to make the mock reserve the same estimated prices as a real provider, to rehearse
# the spend cap without spending anything. Leave at 0 otherwise.
MOCK_PRICES=0

# Your Google AI Studio key, for PROVIDER=gemini. Prefer putting it in the process environment
# (for example from a secrets manager) rather than in this file. Never commit it.
GEMINI_API_KEY=

# Models and length of the real provider. The defaults are the current ones in Google's documentation.
# Changing a model can change what a call costs: re-check the estimates below.
# The text model can also be set in the process environment (it wins over this file). If the default
# keeps timing out or answering 503, a documented fallback is: GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.2-flash
VIDEO_SECONDS=8

# How many figures of one drawing go into a clip (1 to 4). Two is what the documentation supports.
MAX_FIGURES=2

# Retries after a 429 or 5xx answer (0 to 2). 0 means exactly one request per paid call, which is
# the safe choice: a failed video request may still have been billed.
GEMINI_RETRIES=0

# What the spend cap RESERVES per call, in US dollars. These are rough estimates, not prices: check
# Google's current pricing for your models and set them to match. Leave empty to use the built-in
# placeholders in hallway/pricing.py. A value outside the allowed range stops the start. The range
# is from a tenth of the built-in estimate (see hallway/pricing.py) up to 10 US dollars: a lower
# value would let the cap reserve next to nothing.
ESTIMATE_TEXT_USD=
ESTIMATE_IMAGE_USD=
ESTIMATE_VIDEO_SECOND_USD=

# Where the database and media live.
DATA_DIR=./data

# ffmpeg is REQUIRED. The server refuses to start without it. Set this only if it is not on PATH.
FFMPEG_BIN=

# Listen address. Keep 127.0.0.1 unless you know why you change it.
HOST=127.0.0.1
PORT=8080
