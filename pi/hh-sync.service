[Unit]
Description=Haunted Hallway loop sync (pull)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hallway
Group=hallway
Environment=HH_LOOP_DIR=/var/lib/haunted-hallway/loop
EnvironmentFile=/etc/haunted-hallway.env
ExecStart=/usr/bin/python3 /opt/haunted-hallway/pi/sync.py
TimeoutStartSec=300
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/haunted-hallway/loop
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
